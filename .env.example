# 样例语料适配层开关：设为 1 可关闭语料特定规则（app/corpus_adaptations.py），
# 用于消融对比，命令：python scripts/run_ablation.py
# KNOWLEDGEOPS_DISABLE_CORPUS_ADAPTATIONS=1
EMBEDDING_PROVIDER=local
# 默认使用本机 Ollama 已安装的高质量中文模型。
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:9b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 容器内不能用 127.0.0.1 访问宿主机模型；与本地运行配置分开。
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434

# 切换 DeepSeek：LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 切换 OpenAI：LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
