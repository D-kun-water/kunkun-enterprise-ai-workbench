# 样例语料适配层开关：设为 1 可关闭语料特定规则（app/corpus_adaptations.py），
# 用于消融对比，命令：python scripts/run_ablation.py
# KNOWLEDGEOPS_DISABLE_CORPUS_ADAPTATIONS=1
# 默认使用本机 Ollama 的语义 Embedding；请确保该模型已安装。
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=quentinz/bge-large-zh-v1.5:latest
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 离线回归或模型服务不可用时，可设为 local 使用确定性 Hash 基线；它不等价于语义 Embedding。
# EMBEDDING_PROVIDER=local
# 默认回答模型：DeepSeek 云端 API 的最新 Flash 模型。真实密钥只放在本地 .env，禁止提交。
LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# 使用本机大模型时可改为：
# LLM_PROVIDER=ollama
# LLM_MODEL=deepseek-r1:8b
# 容器内不能用 127.0.0.1 访问宿主机模型；与本地运行配置分开。
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434

# 云端模型切换模板：一次只启用一组 LLM_PROVIDER / Base URL / Key / Model 配置。
# GPT（OpenAI API）：先在 Models API 确认当前账号可调用的模型 ID。
# LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# 千问（阿里云百炼 OpenAI 兼容接口）。生产部署建议改为业务空间专属 Base URL。
# LLM_PROVIDER=openai_compatible
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY=你的_DASHSCOPE_API_KEY
# OPENAI_MODEL=qwen-plus

# 智谱（OpenAI 兼容接口）。请在智谱控制台确认账号可调用的 GLM 模型 ID。
# LLM_PROVIDER=openai_compatible
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OPENAI_API_KEY=你的_ZHIPU_API_KEY
# OPENAI_MODEL=你的_GLM_模型_ID
